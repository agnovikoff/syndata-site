---
import { getCollection, render } from 'astro:content';
import SiteLayout from '../../../layouts/SiteLayout.astro';
import { ui } from '../../../i18n/ui';

export async function getStaticPaths() {
  const posts = await getCollection('insights', ({ data }) => data.lang === 'ru');
  return posts.map((post) => ({ params: { slug: post.data.translationKey }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<SiteLayout lang="ru" title={post.data.title} description={post.data.description} canonicalPath={`/ru/insights/${post.data.translationKey}/`}>
  <article class="article">
    <a class="back" href={`${base}/ru/insights/`}>← {ui.ru.back}</a>
    <header><p class="eyebrow">{post.data.topics.join(' · ')}</p><h1>{post.data.title}</h1><p class="dek">{post.data.description}</p><div class="meta">Андрей Новиков <span>·</span> {post.data.publishedAt.toLocaleDateString('ru', { month: 'long', day: 'numeric', year: 'numeric' })}</div></header>
    <div class="article-body"><Content /></div>
    <aside class="source"><div><p class="eyebrow">Источник</p><p>Краткая заметка по публикации Андрея в LinkedIn.</p></div><a class="button-link" href={post.data.originalUrl} target="_blank" rel="noreferrer">Открыть оригинал <span class="arrow">↗</span></a></aside>
  </article>
</SiteLayout>
<style>
 .article{max-width:820px;margin:0 auto;padding:44px 0 20px}.back{font-size:13px;color:var(--blue);font-weight:600}.article header{padding:60px 0 34px;border-bottom:1px solid var(--line)}.article header .eyebrow{margin:0 0 16px}.article h1{font:700 clamp(38px,6vw,64px)/1.08 Manrope,sans-serif;letter-spacing:-.05em;color:var(--navy);margin:0 0 18px}.dek{font-size:19px;line-height:1.55;color:#596a7b;margin:0;max-width:740px}.meta{font:11px 'DM Mono',monospace;color:#7b838b;margin-top:25px}.meta span{padding:0 8px;color:var(--orange)}.article-body{font:17px/1.8 'DM Sans',sans-serif;color:#374a5e;padding:32px 0 42px}.article-body p{margin:0 0 23px}.source{padding:23px;background:#e9ede8;border-left:3px solid var(--green);display:flex;justify-content:space-between;gap:24px;align-items:center}.source p{margin:0}.source p:last-child{font-size:13px;line-height:1.6;color:#596a7b;max-width:440px}.source .button-link{white-space:nowrap;font-size:12px}.source .eyebrow{margin-bottom:8px}@media(max-width:620px){.article header{padding:44px 0 28px}.dek{font-size:16px}.article-body{font-size:16px}.source{display:block}.source .button-link{margin-top:18px}}
</style>
