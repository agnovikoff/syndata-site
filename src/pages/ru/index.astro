---
import { getCollection } from 'astro:content';
import SiteLayout from '../../layouts/SiteLayout.astro';
import { ruInsightLabels } from '../../i18n/insight-labels';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const posts = (await getCollection('insights', ({ data }) => data.lang === 'en'))
  .sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf()).slice(0, 3);
const ruKeys = new Set((await getCollection('insights', ({ data }) => data.lang === 'ru')).map((post) => post.data.translationKey));
---

<SiteLayout lang="ru" title="Корпоративная аналитика в эпоху ИИ" description="Syndata — о корпоративной аналитике, бизнес-инсайтах и ИИ-агентах: от бизнес-данных к знаниям, которые меняют решения." canonicalPath="/ru/">
  <section class="hero">
    <div class="hero-copy"><p class="eyebrow">Корпоративная аналитика · Бизнес-инсайты · ИИ-агенты</p>
      <h1>Аналитика — это не про цифры.<br /><em>Это про знания, которые меняют бизнес.</em></h1>
      <p class="hero-lede">О том, как аналитика, самостоятельный доступ к данным и ИИ-агенты помогают организациям лучше понимать себя и принимать решения.</p>
      <a class="button-link" href={`${base}/ru/insights/`}>Смотреть публикации <span class="arrow">↗</span></a>
    </div>
    <div class="hero-art" role="img" aria-label="Абстрактная схема: сигнал, контекст, решение"><div class="art-caption">СИГНАЛ → КОНТЕКСТ → РЕШЕНИЕ</div><div class="orbit orbit-one"></div><div class="orbit orbit-two"></div><div class="orbit orbit-three"></div><span class="signal signal-a">ДАННЫЕ</span><span class="signal signal-b">ЧТО ИЗМЕНИЛОСЬ?</span><span class="signal signal-c">ЗАЧЕМ ЭТО ВАЖНО</span><span class="signal signal-d">●</span><span class="signal signal-e">●</span><span class="signal signal-f">●</span><div class="art-core"><span>ЗНАНИЕ</span><b>↗</b></div><div class="art-note">Не ещё один дашборд.<br />А лучшее следующее решение.</div></div>
  </section>
  <section class="principles"><article><span class="number">01</span><h2>Аналитика для бизнеса</h2><p>Ценообразование, прибыльность и экономика продукта в контексте реальной работы компании.</p><i class="tone-blue"></i></article><article><span class="number">02</span><h2>Аналитика самообслуживания</h2><p>Семантический слой и контекст для LLM, чтобы команды могли сами решать повторяющиеся аналитические задачи.</p><i class="tone-green"></i></article><article><span class="number">03</span><h2>Аналитика с ИИ-агентами</h2><p>Интерактивные и автономные процессы с контролем и ответственностью человека.</p><i class="tone-orange"></i></article></section>
  <section class="recent"><div class="section-heading"><div><p class="eyebrow">Из практики</p><h2>Идеи, подходы, вопросы.</h2></div><a class="text-link" href={`${base}/ru/insights/`}>Все публикации <span class="arrow">↗</span></a></div><div class="post-grid">{posts.map((post) => { const label = ruInsightLabels[post.data.translationKey]; const isTranslated = ruKeys.has(post.data.translationKey); return <a class="post-card" href={`${base}${isTranslated ? `/ru/insights/${post.data.translationKey}/` : `/insights/${post.data.translationKey}/`}`}><span class="card-top"><span>{label?.category ?? 'Заметка'}</span><span>↗</span></span><h3>{label?.title ?? post.data.title}</h3><p>{label?.description ?? post.data.description}</p><span class="card-bottom">{isTranslated ? 'Русская версия' : 'Текст заметки — на английском'}</span></a>; })}</div></section>
  <section class="closing"><p class="eyebrow">Рабочий принцип</p><p class="closing-quote">«От отчёта о том, что произошло, — к пониманию бизнеса, которое помогает действовать».</p><a class="text-link" href={`${base}/ru/about/`}>Об Андрее <span class="arrow">↗</span></a></section>
</SiteLayout>

<style>
  .hero{display:grid;grid-template-columns:1.13fr .87fr;gap:42px;align-items:center;padding:84px 0 92px}.hero-copy{max-width:690px}.hero h1{font:700 clamp(42px,5.6vw,68px)/1.08 Manrope,sans-serif;letter-spacing:-.055em;color:var(--navy);margin:24px 0}.hero h1 em{font-style:normal;color:var(--blue)}.hero-lede{font-size:17px;line-height:1.7;color:#536273;max-width:570px;margin:0 0 28px}.hero-art{height:400px;position:relative;overflow:hidden;background:#e8ece5;border-radius:3px}.hero-art:before{content:'';position:absolute;inset:0;background:linear-gradient(135deg,transparent 45%,rgba(57,120,184,.09)),radial-gradient(circle at 35% 52%,#f4f1e7 0,#f4f1e7 13%,transparent 13.5%)}.art-caption{position:absolute;top:24px;left:24px;font:10px 'DM Mono',monospace;letter-spacing:.12em;color:#6a786f}.orbit{position:absolute;border:1px solid rgba(20,44,70,.17);border-radius:50%;left:50%;top:48%;transform:translate(-50%,-50%);aspect-ratio:1}.orbit-one{width:170px}.orbit-two{width:280px}.orbit-three{width:390px}.art-core{position:absolute;left:50%;top:48%;transform:translate(-50%,-50%);width:118px;height:118px;border-radius:50%;background:var(--navy);color:#fff;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:6px;box-shadow:0 15px 40px #142c4630}.art-core span{font:10px 'DM Mono',monospace;letter-spacing:.08em}.art-core b{color:#9cc7e7;font-size:24px}.signal{position:absolute;font:9px 'DM Mono',monospace;letter-spacing:.1em;background:var(--paper);padding:8px 10px;border:1px solid #d5d8d0;color:var(--navy)}.signal-a{left:14%;top:25%}.signal-b{right:8%;top:32%;color:var(--blue)}.signal-c{left:10%;bottom:24%;color:#687f58}.signal-d{right:26%;top:18%;color:var(--orange);background:none;border:0;font-size:18px}.signal-e{left:23%;bottom:39%;color:var(--blue);background:none;border:0;font-size:12px}.signal-f{right:18%;bottom:22%;color:#68875d;background:none;border:0;font-size:13px}.art-note{position:absolute;right:24px;bottom:22px;font-size:11px;line-height:1.6;color:#66736b;text-align:right}.principles{display:grid;grid-template-columns:repeat(3,1fr);border-top:1px solid var(--line);border-bottom:1px solid var(--line)}.principles article{padding:26px 26px 28px 0;position:relative}.principles article+article{border-left:1px solid var(--line);padding-left:27px}.number{font:11px 'DM Mono',monospace;color:var(--blue)}.principles h2{font:600 20px Manrope,sans-serif;margin:28px 0 10px;color:var(--navy)}.principles p{font-size:14px;line-height:1.65;color:var(--muted);margin:0;max-width:290px}.principles i{display:block;width:31px;height:3px;margin-top:22px}.tone-blue{background:var(--blue)}.tone-green{background:var(--green)}.tone-orange{background:var(--orange)}.recent{padding:84px 0 0}.section-heading{display:flex;justify-content:space-between;align-items:end;margin-bottom:24px}.section-heading h2{font:600 32px Manrope,sans-serif;letter-spacing:-.04em;margin:11px 0 0}.post-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:15px}.post-card{min-height:230px;padding:22px;display:flex;flex-direction:column;border:1px solid var(--line);background:#faf9f5;transition:border .2s,transform .2s}.post-card:hover{border-color:#9eafbd;transform:translateY(-3px);color:var(--navy)}.card-top,.card-bottom{display:flex;justify-content:space-between;font:10px 'DM Mono',monospace;letter-spacing:.06em;text-transform:uppercase;color:var(--blue)}.card-top span+span{font-size:16px}.post-card h3{font:600 20px/1.25 Manrope,sans-serif;letter-spacing:-.025em;margin:28px 0 10px}.post-card p{font-size:13px;line-height:1.6;color:var(--muted);margin:0 0 24px}.card-bottom{margin-top:auto;color:#78818a}.closing{margin:100px 0 30px;padding:32px;background:#e9ede8;border-left:3px solid var(--green)}.closing-quote{max-width:780px;font:500 28px/1.35 Manrope,sans-serif;letter-spacing:-.03em;color:var(--navy);margin:20px 0}.closing .text-link{font-size:13px}@media(max-width:860px){.hero{grid-template-columns:1fr;padding:62px 0}.hero-art{max-width:600px;width:100%;margin:auto}.post-grid{grid-template-columns:1fr 1fr}.post-card:last-child{grid-column:1/-1}}@media(max-width:580px){.hero h1{font-size:43px}.hero-art{height:310px}.orbit-three{width:320px}.orbit-two{width:230px}.principles{grid-template-columns:1fr}.principles article,.principles article+article{padding:22px 0;border-left:0;border-bottom:1px solid var(--line)}.principles h2{margin-top:15px}.post-grid{grid-template-columns:1fr}.post-card:last-child{grid-column:auto}.section-heading{align-items:start;gap:20px;flex-direction:column}.section-heading h2{font-size:27px}.closing{margin-top:70px;padding:24px}.closing-quote{font-size:23px}}
</style>
