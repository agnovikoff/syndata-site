---
import { getCollection } from 'astro:content';
import SiteLayout from '../../layouts/SiteLayout.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const posts = (await getCollection('insights', ({ data }) => data.lang === 'en'))
  .sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());
---
<SiteLayout title="Insights" description="Notes on enterprise analytics, business economics and AI agents.">
  <section class="intro"><p class="eyebrow">Field notes</p><h1>Insights</h1><p>Short notes on the systems, decisions and ideas shaping modern analytics.</p></section>
  <section class="list" aria-label="Insights">{posts.map((post) => <article class="row"><div class="date">{post.data.publishedAt.toLocaleDateString('en', { month: 'short', day: 'numeric', year: 'numeric' })}</div><div><p class="eyebrow">{post.data.topics.join(' · ')}</p><h2><a href={`${base}/insights/${post.data.translationKey}/`}>{post.data.title}</a></h2><p class="summary">{post.data.description}</p></div><a class="row-arrow" href={`${base}/insights/${post.data.translationKey}/`} aria-label={`Read ${post.data.title}`}>↗</a></article>)}</section>
</SiteLayout>
<style>
 .intro{padding:84px 0 48px;max-width:680px}.intro h1{font:700 clamp(48px,7vw,76px)/1 Manrope,sans-serif;letter-spacing:-.06em;margin:18px 0;color:var(--navy)}.intro>p:last-child{font-size:17px;line-height:1.65;color:var(--muted)}.list{border-top:1px solid var(--line)}.row{display:grid;grid-template-columns:130px 1fr 40px;gap:20px;padding:27px 0;border-bottom:1px solid var(--line);align-items:start}.date{font:11px 'DM Mono',monospace;text-transform:uppercase;color:#78818a;padding-top:4px}.row .eyebrow{margin:0 0 10px;font-size:10px}.row h2{font:600 24px/1.25 Manrope,sans-serif;letter-spacing:-.025em;margin:0 0 9px;max-width:700px}.summary{font-size:14px;line-height:1.65;color:var(--muted);margin:0;max-width:730px}.row-arrow{font-size:24px;color:var(--blue);justify-self:end}.row h2 a:hover{color:var(--blue)}@media(max-width:600px){.intro{padding:60px 0 35px}.row{grid-template-columns:1fr 30px;gap:8px}.date{grid-column:1/-1}.row-arrow{grid-column:2;grid-row:2}.row h2{font-size:21px}}
</style>
