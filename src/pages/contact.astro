---
import SiteLayout from '../layouts/SiteLayout.astro';
---
<SiteLayout title="Contact" description="Connect with Andrey Novikov on LinkedIn to discuss analytics, pricing and AI-enabled workflows.">
  <section class="contact"><p class="eyebrow">Contact</p><h1>Have a question<br /><em>worth exploring?</em></h1><p class="lede">For a conversation about analytics, pricing, unit economics or AI-enabled workflows, the best place to reach me is LinkedIn.</p><a class="button-link" href="https://www.linkedin.com/in/andreygnovikov/" target="_blank" rel="noreferrer">Connect on LinkedIn <span class="arrow">↗</span></a><div class="note"><span>01</span><p>Thoughtful questions, project ideas and exchanges of experience are welcome.</p></div></section>
</SiteLayout>
<style>
 .contact{min-height:560px;max-width:760px;padding:100px 0 80px}.contact h1{font:700 clamp(48px,7vw,78px)/1.06 Manrope,sans-serif;letter-spacing:-.06em;color:var(--navy);margin:22px 0}.contact h1 em{font-style:normal;color:var(--blue)}.lede{font-size:18px;line-height:1.7;color:#536273;max-width:610px;margin-bottom:28px}.note{margin-top:72px;padding-top:20px;border-top:1px solid var(--line);display:flex;gap:22px;align-items:start}.note span{font:11px 'DM Mono',monospace;color:var(--orange)}.note p{font-size:14px;color:var(--muted);margin:0}
</style>
